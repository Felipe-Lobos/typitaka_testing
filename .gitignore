# .gitignore - Ignorar archivos comunes para proyecto Maven + Selenium

#Reporter build
.allure
allure-results/

# Maven build
/target/
/out/
*.class
*.jar
*.war
*.ear
dependency-reduced-pom.xml
release.properties
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next

# IDEs
/.idea/
/*.iml
*.ipr
*.iws
.vscode/
/.classpath
.project
.settings/

# OS
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Logs and reports
*.log
logs/
target/surefire-reports/
target/failsafe-reports/
test-output/
reports/
screenshots/

# Selenium / WebDriver binaries
/drivers/
/webdrivers/
chromedriver*
geckodriver*
msedgedriver*
IEDriverServer*
*.exe

# Credentials / local config
.env
local.properties
secrets.properties
*.jks
*.keystore
*.p12
*.pem

# Coverage / tooling
jacoco.exec
coverage/
.coverage
.nyc_output/

# Gradle (si acaso)
.gradle/
build/

# Temporary / editors
*~
*.swp
*.swo
._*
.idea_work/